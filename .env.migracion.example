# Copia este archivo a .env.migracion (no se sube a GitHub) y complétalo.
# Cada valor está en Supabase → Project Settings → API (o "API Keys").
# Usa la clave service_role / secret (NO la anon): hace falta para leer
# las solicitudes y copiar Storage saltándose las políticas RLS.

# Proyecto de la cuenta VIEJA
OLD_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
OLD_SERVICE_ROLE_KEY=

# Proyecto de la cuenta NUEVA
NEW_SUPABASE_URL=https://yyyyyyyyyyyy.supabase.co
NEW_SERVICE_ROLE_KEY=
